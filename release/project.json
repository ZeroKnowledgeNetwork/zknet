{
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "name": "release",
  "projectType": "library",
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/*.mjs",
        "{projectRoot}/components.json",
        "{workspaceRoot}/libs/client-core/updater-key.pub",
        "{workspaceRoot}/apps/client/src-tauri/tauri.dev.conf.json"
      ],
      "options": {
        "command": "node --test release.test.mjs",
        "cwd": "{projectRoot}"
      }
    }
  }
}
