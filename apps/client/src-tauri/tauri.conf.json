{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZKNetwork",
  "identifier": "io.zknet.client",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm exec vite build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Zero Knowledge Network - Client",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["deb", "rpm", "appimage", "nsis", "app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "SET-AT-BUILD-TIME: the release build passes ZKNET_UPDATER_PUBKEY",
      "endpoints": ["https://updater-endpoint.invalid/set-at-build-time/latest.json"]
    },
    "zknet": {
      "apiListenAddress": "127.0.0.1:7000",
      "defaultWalletshieldListenAddress": ":7070",
      "urlNetwork": "https://dist.zknet.io",
      "walletshieldLogLevel": "INFO",
      "updater": true,
      "allowUnsigned": false
    }
  }
}
