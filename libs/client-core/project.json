{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "client-core",
  "projectType": "library",
  "sourceRoot": "libs/client-core/src",
  "tags": [],
  "namedInputs": {
    "rustSources": [
      "{projectRoot}/Cargo.toml",
      "{projectRoot}/asset-key.pub",
      "{projectRoot}/src/**/*.rs",
      "{projectRoot}/tests/**/*.rs"
    ]
  },
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["rustSources", "^rustSources", "cargoWorkspace"],
      "options": {
        "command": "cargo check --locked --target-dir dist/target -p zknet_client_core --all-targets"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "rustSources",
        "^rustSources",
        "cargoWorkspace",
        "{workspaceRoot}/apps/network-assets/fixtures/**"
      ],
      "options": {
        "command": "cargo test --locked --target-dir dist/target -p zknet_client_core"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["rustSources", "^rustSources", "cargoWorkspace"],
      "options": {
        "command": "cargo clippy --locked --target-dir dist/target -p zknet_client_core --all-targets"
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "cargo fmt -p zknet_client_core"
      }
    },
    "format:check": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["rustSources"],
      "options": {
        "command": "cargo fmt -p zknet_client_core -- --check"
      }
    },
    "clean": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "cargo clean --target-dir dist/target -p zknet_client_core"
      }
    }
  }
}
