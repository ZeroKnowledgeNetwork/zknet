# Copy to .woodpecker/local.env (git-ignored) to set this machine's settings
# for .woodpecker/run. The environment still wins over this file.

# The host cache directory: an absolute path that outlives the container or VM
# the pipelines are started from.
ZKNET_WOODPECKER_CACHE=/var/tmp/zknet-woodpecker

# A woodpecker-cli secrets file (YAML: name: value) passed to every pipeline,
# e.g. tauri_signing_private_key and tauri_signing_private_key_password for a
# tag (release) build of dist.yaml. Keep it outside the repository.
#ZKNET_WOODPECKER_SECRETS=$HOME/.config/zknet/woodpecker-secrets.yaml
