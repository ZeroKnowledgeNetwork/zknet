{
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "name": "app-walletshield",
  "projectType": "application",
  "implicitDependencies": ["opt-common", "rpc-proxy"],
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/**/*.go",
        "{projectRoot}/testdata/**",
        "^default",
        "optModule",
        "{workspaceRoot}/packages/opt/served.sh",
        "{workspaceRoot}/packages/opt/test_served.py",
        "{workspaceRoot}/packages/opt/.goreleaser.yaml",
        "{workspaceRoot}/libs/client-core/src/network.rs"
      ],
      "options": {
        "commands": ["go test ./...", "python3 -B -m unittest discover -s ../.. -p test_served.py"],
        "cwd": "{projectRoot}",
        "parallel": false
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["{projectRoot}/**/*.go", "^default", "optModule"],
      "outputs": ["{projectRoot}/walletshield"],
      "options": {
        "command": "make app-walletshield",
        "cwd": "packages/opt"
      }
    },
    "dev-remote": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["build"],
      "options": {
        "command": "./walletshield -config \"${remote_client_config:?set remote_client_config=/path/to/client.toml}\" -listen \"${ws_listen:-:7070}\" -log_level ${log_level:-DEBUG} ${ws_extra_flags:-}",
        "cwd": "{projectRoot}"
      }
    },
    "dist": {
      "executor": "nx:run-commands",
      "cache": false,
      "outputs": ["{workspaceRoot}/dist/walletshield"],
      "options": {
        "cwd": "packages/opt"
      },
      "defaultConfiguration": "dev",
      "configurations": {
        "dev": {
          "command": "./dist.sh dev"
        },
        "release": {
          "command": "./dist.sh release"
        }
      }
    }
  }
}
