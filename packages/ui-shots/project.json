{
  "name": "ui-shots",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "tags": [],
  "implicitDependencies": ["client", "downloads"],
  "targets": {
    "shots": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["client:build", "downloads:build"],
      "options": {
        "command": "node packages/ui-shots/src/shots.ts",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
