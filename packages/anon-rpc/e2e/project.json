{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "anon-rpc-e2e",
  "projectType": "application",
  "tags": ["scope:anon-rpc"],
  "implicitDependencies": ["anon-rpc-specifier", "anon-rpc-worker"],
  "targets": {
    "e2e": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["anon-rpc-worker:build"],
      "options": {
        "command": "node_modules/.bin/playwright test --project=pinned",
        "cwd": "{projectRoot}"
      }
    },
    "e2e-fork": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["anon-rpc-worker:build"],
      "options": {
        "command": "node_modules/.bin/playwright test --project=fork",
        "cwd": "{projectRoot}"
      }
    },
    "live": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["anon-rpc-worker:build"],
      "options": {
        "command": "node_modules/.bin/playwright test --project=live --reporter=list",
        "cwd": "{projectRoot}"
      }
    }
  }
}
