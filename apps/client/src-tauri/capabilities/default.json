{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "fs:default",
    "log:default",
    "opener:default",
    "os:allow-arch",
    "os:allow-platform",
    "shell:allow-kill",
    "shell:default",
    "store:default",
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [
        {
          "path": "$APPLOCALDATA/networks/**"
        }
      ]
    },
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "walletshield-listen",
          "cmd": "walletshield",
          "args": [
            "-listen",
            {
              "validator": "^(\\S*:\\d+)$"
            },
            "-config",
            "client.toml",
            "-log_level",
            {
              "validator": "^(DEBUG|INFO|WARN|ERROR)$"
            }
          ],
          "sidecar": false
        }
      ]
    },
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "walletshield-probe",
          "cmd": "walletshield",
          "args": [
            "-probe",
            "-config",
            {
              "validator": "\\S+"
            }
          ],
          "sidecar": false
        }
      ]
    }
  ]
}
