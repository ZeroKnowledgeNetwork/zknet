# The downloads site's settings: copy to .env (git-ignored) and fill in. Vite
# reads them at build time; nothing here is secret, and every value ends up in
# the built page. An empty link is hidden.

# Where the release files are: <base>/<id>/<channel>/downloads.json.
# The page reads the client's and client-cli's from here, and the build bakes a
# copy as the fallback. Empty: the page has no downloads.
VITE_DOWNLOADS_BASE=
# stable or beta
VITE_CHANNEL=beta

# The site's own origin, e.g. https://example.org. The CLI section shows
# `curl -fsSL <origin>/install.sh | sh`; empty hides it.
VITE_SITE_URL=

# Links
VITE_DOCS_URL=
VITE_WALLET_DOCS_URL=
VITE_SOURCE_URL=
VITE_RELEASES_URL=
