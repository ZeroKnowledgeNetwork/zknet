{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "anon-rpc-specifier",
  "projectType": "library",
  "tags": ["scope:anon-rpc"],
  "targets": {
    "compile": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["{projectRoot}/src/**/*.sol", "{projectRoot}/foundry.toml"],
      "outputs": ["{projectRoot}/out"],
      "options": {
        "command": "node scripts/foundry.mjs forge build",
        "cwd": "{projectRoot}"
      }
    },
    "test-sol": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*.sol",
        "{projectRoot}/test/**/*.sol",
        "{projectRoot}/foundry.toml"
      ],
      "options": {
        "command": "node scripts/foundry.mjs forge test",
        "cwd": "{projectRoot}"
      }
    },
    "test-js": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/scripts/**/*.mjs",
        "{projectRoot}/tests/**/*.mjs",
        "{projectRoot}/fixtures/**/*"
      ],
      "options": {
        "command": "node --test 'tests/*.test.mjs'",
        "cwd": "{projectRoot}"
      }
    },
    "test": {
      "executor": "nx:noop",
      "dependsOn": ["test-sol", "test-js"]
    },
    "fmt-check": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["{projectRoot}/test/**/*.sol", "{projectRoot}/foundry.toml"],
      "options": {
        "command": "node scripts/foundry.mjs forge fmt --check test/ReferenceBytecode.t.sol test/WorkerSpecifierEvents.t.sol test/utils",
        "cwd": "{projectRoot}"
      }
    },
    "hash": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node scripts/hash.mjs --write",
        "cwd": "{projectRoot}"
      }
    },
    "preflight": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        "compile",
        "test",
        "fmt-check",
        "lint",
        {
          "projects": ["anon-rpc-worker", "anon-rpc-transport"],
          "target": "lint"
        },
        {
          "projects": ["anon-rpc-worker", "anon-rpc-transport"],
          "target": "typecheck"
        },
        {
          "projects": ["anon-rpc-worker", "anon-rpc-transport"],
          "target": "test"
        },
        "anon-rpc-worker:build"
      ],
      "defaultConfiguration": "dev",
      "options": {
        "command": "node scripts/preflight.mjs --tier dev",
        "cwd": "{projectRoot}"
      },
      "configurations": {
        "dev": {
          "command": "node scripts/preflight.mjs --tier dev"
        },
        "test": {
          "command": "node scripts/preflight.mjs --tier test"
        },
        "prod": {
          "command": "node scripts/preflight.mjs --tier prod"
        }
      }
    },
    "reproducible": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node scripts/reproducible.mjs",
        "cwd": "{projectRoot}"
      }
    },
    "resolver": {
      "executor": "nx:run-commands",
      "cache": false,
      "continuous": true,
      "options": {
        "command": "node scripts/resolver.mjs serve",
        "cwd": "{projectRoot}"
      }
    },
    "resolver-put": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node scripts/resolver.mjs put",
        "cwd": "{projectRoot}"
      }
    },
    "resolver-start": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node scripts/resolver.mjs start",
        "cwd": "{projectRoot}"
      }
    },
    "resolver-stop": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node scripts/resolver.mjs stop",
        "cwd": "{projectRoot}"
      }
    },
    "anvil-start": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node scripts/anvil.mjs start",
        "cwd": "{projectRoot}"
      }
    },
    "anvil-stop": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node scripts/anvil.mjs stop",
        "cwd": "{projectRoot}"
      }
    },
    "publish": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["preflight"],
      "defaultConfiguration": "dev",
      "options": {
        "command": "node scripts/publish.mjs --tier dev",
        "cwd": "{projectRoot}"
      },
      "configurations": {
        "dev": {
          "command": "node scripts/publish.mjs --tier dev"
        },
        "test": {
          "command": "node scripts/publish.mjs --tier test"
        },
        "prod": {
          "command": "node scripts/publish.mjs --tier prod"
        }
      }
    },
    "deploy": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["preflight"],
      "defaultConfiguration": "dev",
      "options": {
        "command": "node scripts/deploy.mjs --tier dev",
        "cwd": "{projectRoot}",
        "tty": true
      },
      "configurations": {
        "dev": {
          "command": "node scripts/deploy.mjs --tier dev"
        },
        "test": {
          "command": "node scripts/deploy.mjs --tier test"
        },
        "prod": {
          "command": "node scripts/deploy.mjs --tier prod"
        }
      }
    },
    "verify": {
      "executor": "nx:run-commands",
      "cache": false,
      "defaultConfiguration": "dev",
      "options": {
        "command": "node scripts/verify.mjs --tier dev",
        "cwd": "{projectRoot}"
      },
      "configurations": {
        "dev": {
          "command": "node scripts/verify.mjs --tier dev"
        },
        "test": {
          "command": "node scripts/verify.mjs --tier test"
        },
        "prod": {
          "command": "node scripts/verify.mjs --tier prod"
        }
      }
    },
    "verify-source": {
      "executor": "nx:run-commands",
      "cache": false,
      "defaultConfiguration": "test",
      "options": {
        "command": "node scripts/verify-source.mjs --tier test",
        "cwd": "{projectRoot}"
      },
      "configurations": {
        "test": {
          "command": "node scripts/verify-source.mjs --tier test"
        },
        "prod": {
          "command": "node scripts/verify-source.mjs --tier prod"
        }
      }
    },
    "e2e": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node scripts/e2e.mjs",
        "cwd": "{projectRoot}"
      }
    },
    "demo-up": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["anon-rpc-worker:build"],
      "options": {
        "command": "node scripts/demo.mjs up",
        "cwd": "{projectRoot}"
      }
    },
    "demo-down": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node scripts/demo.mjs down",
        "cwd": "{projectRoot}"
      }
    }
  }
}
