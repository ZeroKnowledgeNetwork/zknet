{
  "name": "@zknet/anon-rpc-worker",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@zknet/anon-rpc-transport": "workspace:*"
  },
  "nx": {
    "targets": {
      "build": {
        "command": "node build.mjs",
        "options": {
          "cwd": "{projectRoot}"
        },
        "inputs": [
          "production",
          "^production",
          {
            "externalDependencies": [
              "esbuild",
              "@noble/hashes"
            ]
          }
        ],
        "outputs": [
          "{projectRoot}/dist"
        ],
        "cache": true
      }
    },
    "name": "anon-rpc-worker"
  }
}
