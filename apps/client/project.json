{
  "name": "@zknet/client",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "outputs": ["{projectRoot}/dist"]
    },
    "desktop-dev": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "pnpm tauri dev --config src-tauri/tauri.dev.conf.json",
        "cwd": "{projectRoot}"
      }
    },
    "desktop-dev-local": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["network-assets:serve"],
      "options": {
        "command": "python3 ../network-assets/server.py ready && pnpm tauri dev --config src-tauri/tauri.dev-local.conf.json --config src-tauri/tauri.dev.conf.json",
        "cwd": "{projectRoot}"
      }
    },
    "desktop-build": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "{projectRoot}"
      },
      "defaultConfiguration": "dev",
      "configurations": {
        "dev": {
          "command": "pnpm tauri build --debug --config src-tauri/tauri.dev-local.conf.json --config src-tauri/tauri.dev.conf.json",
          "env": {
            "CARGO_PROFILE_DEV_STRIP": "debuginfo"
          }
        },
        "release": {
          "command": "node ../../release/release.mjs tauri-config ../../dist/tauri.release.conf.json && pnpm tauri build --config ../../dist/tauri.release.conf.json"
        }
      }
    }
  }
}
